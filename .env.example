# Panel serveri
PORT=4310
# Bo'sh bo'lsa API himoyasiz — faqat o'z kompyuteringizda shunday qoldiring. Serverda kamida 16 belgi.
ADMIN_TOKEN=
DATA_DIR=./data
# Ixtiyoriy: Turso (libsql://…) masofaviy bazasi
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Worker (tools/worker.ts). WORKER=1 bo'lsa server ichida ishlaydi
WORKER=0
PANEL_URL=http://localhost:4310
MEDIA_DIR=./media
WORKER_INTERVAL=60

# Telegram (tayyor adapter)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@kanal_nomi

# Boshqa platformalar (adapter skeletlari tools/worker.ts ichida)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
