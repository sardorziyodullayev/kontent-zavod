# Panel serveri
PORT=4310
# Bo'sh bo'lsa API himoyasiz — faqat o'z kompyuteringizda shunday qoldiring. Serverda kamida 16 belgi.
ADMIN_TOKEN=
DATA_DIR=./data
# Ixtiyoriy: Turso (libsql://…) masofaviy bazasi. Berilsa media va worker fayllari ham bazaga yoziladi
# va ishga tushishda tiklanadi (disk o'chadigan hosting: Render free). FILES_IN_DB=1 — mahalliy sinov uchun.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Uxlaydigan hosting uchun o'z manzili (Render'da RENDER_EXTERNAL_URL avtomatik): har 10 daqiqada /api/health
KEEPALIVE_URL=

# Worker (tools/worker.ts). WORKER=1 bo'lsa server ichida ishlaydi
WORKER=0
PANEL_URL=http://localhost:4310
MEDIA_DIR=./media
WORKER_INTERVAL=60

# Telegram (tayyor adapter)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@kanal_nomi
# Ertalabki hisobot: botga /start yozing, javobdagi chat ID ni shu yerga qo'ying
TELEGRAM_OWNER_ID=
DIGEST_HOUR=8

# YouTube: npm run youtube:auth to'ldiradi
# Boshqa platformalar (adapter skeletlari tools/worker.ts ichida)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private (audit qilinmagan loyihada YouTube baribir private qiladi)
YOUTUBE_PRIVACY=public
MEDIA_MAX_MB=300
# Instagram (Instagram Login API): Meta app → Instagram → API setup → Generate token. Faqat Reels (video).
IG_USER_ID=
IG_ACCESS_TOKEN=
# Instagram videoni shu ochiq manzildan yuklab oladi (Render'da RENDER_EXTERNAL_URL avtomatik)
PUBLIC_URL=
TIKTOK_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=
