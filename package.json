{
  "name": "kontent-zavod",
  "version": "2.0.0",
  "description": "Kontent zavod: videolarni ijtimoiy tarmoqlarga joylash, reja va analitika admin paneli",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,green \"npm:dev:api\" \"vite\"",
    "dev:api": "node --watch-path=server --watch-path=src/core --import tsx --env-file-if-exists=.env server/index.ts --port 4310",
    "build": "tsc && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "worker": "tsx --env-file-if-exists=.env tools/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "youtube:auth": "tsx --env-file-if-exists=.env tools/youtube-auth.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
